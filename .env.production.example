# ==============================================================================
# Production Environment Configuration Template
# COPY TO .env.production AND FILL IN SECURE RANDOM VALUES BEFORE STARTUP
# ==============================================================================

# Application Environment
APP_ENV=production
PORT=8000
LOG_LEVEL=INFO
REQUIRE_AUTH=true

# Security: JWT Token Encryption Secret (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_64_character_hex_random_key_in_production_environment

# PostgreSQL Database Configuration
POSTGRES_DB=jewellery_catalog
POSTGRES_USER=jewellery_user
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password

# Database URL used by the App Container
# DATABASE_URL=postgresql://jewellery_user:${POSTGRES_PASSWORD}@postgres:5432/jewellery_catalog

# Distributed Cache & Rate Limiting
REDIS_URL=redis://redis:6379/0

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
