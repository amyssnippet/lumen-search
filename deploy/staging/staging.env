# Staging Environment Configuration for Jewellery Visual Retrieval Engine (PH-011)

APP_ENV=staging
PORT=8001
LOG_LEVEL=INFO

# Staging PostgreSQL (Loopback exposed on 5433 from docker container)
POSTGRES_DB=jewellery_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=staging_secret_pass_2026
DATABASE_URL=postgresql://staging_user:staging_secret_pass_2026@127.0.0.1:5433/jewellery_staging

# Staging Redis (Loopback exposed on 6380 from docker container)
REDIS_URL=redis://127.0.0.1:6380/0

# Staging Qdrant (Loopback exposed on 6335 from docker container)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6335
QDRANT_PRODUCTION_ALIAS=jewellery_catalog_mobilenetv4_staging

# Staging Authentication & Security
REQUIRE_AUTH=true
JWT_SECRET_KEY=staging_super_secret_jwt_key_2026_secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Staging NGINX Edge Proxy
STAGING_HTTP_PORT=8080
STAGING_HTTPS_PORT=8443
STAGING_DOMAIN=staging.jewellery-search.local
REQUIRE_REVERSE_PROXY=true
INTERNAL_PROXY_SECRET=sec_prx_fa84f505654dd0421aea9d785672a7c6bfcb634875d3371ee2e28c7945cb81b9
