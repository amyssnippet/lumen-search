# ==============================================================================
# Production Environment Configuration Template (Milestone PH-012)
#
# IMPORTANT SECURITY NOTICE:
# 1. Never commit populated .env.production files to version control.
# 2. In production cloud environments, populate these variables from an authoritative
#    secrets manager (e.g. AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault).
# 3. All passwords and keys MUST adhere to minimum entropy standards (>= 32 characters).
# 4. The application startup validator will fail startup if default/staging credentials
#    are detected in production mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Application Mode
# ------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL 16 Production Relational Database
# ------------------------------------------------------------------------------
POSTGRES_DB=jewellery_catalog_prod
POSTGRES_USER=jewellery_prod_admin
# MUST be unique, cryptographically strong, and >= 32 characters. Do NOT use staging credentials.
POSTGRES_PASSWORD=<GENERATE_SECURE_32_CHAR_POSTGRES_PASSWORD>
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@prod_postgres:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# Redis 7 Distributed Rate Limiter
# ------------------------------------------------------------------------------
REDIS_URL=redis://prod_redis:6379/0

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_HOST=prod_qdrant
QDRANT_PORT=6333
QDRANT_PRODUCTION_ALIAS=jewellery_catalog_mobilenetv4_prod

# ------------------------------------------------------------------------------
# Authentication, JWT & Cryptographic Tokens
# ------------------------------------------------------------------------------
REQUIRE_AUTH=true
# MUST be cryptographically random and >= 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=<GENERATE_SECURE_32_CHAR_JWT_SECRET_KEY>

# ------------------------------------------------------------------------------
# Edge Perimeter Security & Reverse Proxy Secret
# ------------------------------------------------------------------------------
REQUIRE_REVERSE_PROXY=true
# Secret passed between NGINX and FastAPI backend to prevent perimeter bypass
INTERNAL_PROXY_SECRET=<GENERATE_SECURE_32_CHAR_PROXY_SECRET>

# ------------------------------------------------------------------------------
# Continuous Monitoring & Alertmanager
# ------------------------------------------------------------------------------
ALERTMANAGER_WEBHOOK_URL=https://alerts.jewellery-search.internal/webhook/pagerduty
