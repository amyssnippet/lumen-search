# ==============================================================================
# Jewellery Visual Retrieval Engine — Interactive Demo Environment (.env.demo)
# ==============================================================================

# Core Demo Web & Gateway
WEB_PORT=3000
BACKEND_URL=http://demo_backend:8000

# Backend Security & Authentication
REQUIRE_AUTH=true
JWT_SECRET_KEY=demo_secure_jwt_secret_key_2026_super_safe
REQUIRE_REVERSE_PROXY=true
INTERNAL_PROXY_SECRET=demo_internal_edge_proxy_secret_2026_x87a

# Relational Database (Internal to Docker Network)
POSTGRES_DB=jewellery_demo
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=demo_secret_pass_2026
DATABASE_URL=postgresql://demo_user:demo_secret_pass_2026@demo_db:5432/jewellery_demo

# Distributed Cache & Rate Limiting (Internal)
REDIS_URL=redis://demo_redis:6379/0

# Qdrant Vector Engine & Index Alias (Internal)
QDRANT_HOST=demo_qdrant
QDRANT_PORT=6333
QDRANT_PRODUCTION_ALIAS=jewellery_catalog_mobilenetv4_staging

# Pre-seeded Demo Credentials
DEMO_USER_EMAIL=admin@jewellery.internal
DEMO_USER_PASSWORD=dev_password_2026
